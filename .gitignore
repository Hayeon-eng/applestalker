# ========================================
# Apple Stalker - .gitignore
# ========================================

# ----------------------------------------
# Environment Variables (보안 필수!)
# ----------------------------------------
.env
.env.local
.env.production
.env.*.local

# ----------------------------------------
# Python
# ----------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
ENV/
env/
.venv/
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ----------------------------------------
# Node.js / Next.js
# ----------------------------------------
node_modules/
.next/
out/
build
dist
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ----------------------------------------
# Database (SQLite)
# ----------------------------------------
*.db
*.sqlite
*.sqlite3
apple_tracker.db

# ----------------------------------------
# Logs
# ----------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------
# Screenshots & Snapshots (대용량 파일)
# ----------------------------------------
screenshots/
snapshots/

# ----------------------------------------
# IDE / Editor
# ----------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.ipr
*.iws

# PyCharm
.idea/
*.pyc
__pycache__/

# ----------------------------------------
# OS
# ----------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ----------------------------------------
# Temporary Files
# ----------------------------------------
*.tmp
*.bak
*.swp
*~
.cache/
.temp/

# ----------------------------------------
# Testing
# ----------------------------------------
coverage/
.nyc_output/
*.cover
.hypothesis/

