# Apple Tracker Environment Variables

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./apple_tracker.db

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Crawl Settings
CRAWL_DELAY_SECONDS=2
MAX_CONCURRENT_CRAWLS=3

# Sites to Track
APPLE_BASE_URL=https://www.apple.com
SAMSUNG_BASE_URL=https://www.samsung.com/sg

# Storage Paths
SNAPSHOTS_DIR=./snapshots
SCREENSHOTS_DIR=./screenshots
LOGS_DIR=./logs

# Email Report Settings (Naver Mail)
# 네이버 앱 비밀번호 발급: 네이버 → 보안설정 → 앱별 비밀번호
SMTP_SERVER=smtp.naver.com
SMTP_PORT=587
SENDER_EMAIL=h1013ge@naver.com
SENDER_PASSWORD=C4XJV957PYQW
RECIPIENT_EMAIL=hayeon2.kwon@samsung.com
EMAIL_REPORT_ENABLED=true
