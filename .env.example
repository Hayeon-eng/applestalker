# Apple Tracker Environment Variables

# Gemini API Key (Required)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./apple_tracker.db

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO

# Crawl Settings
CRAWL_DELAY_SECONDS=2
MAX_CONCURRENT_CRAWLS=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Scheduler Settings
# Cron format: minute hour day month day_of_week
# Default: Daily at 09:00 and 14:00 KST
CRAWL_SCHEDULE=0 0,5 * * *

# Sites to Track
APPLE_BASE_URL=https://www.apple.com
SAMSUNG_BASE_URL=https://www.samsung.com/sg

# Storage Paths
SNAPSHOTS_DIR=./snapshots
SCREENSHOTS_DIR=./screenshots
LOGS_DIR=./logs

# Frontend API URL (for production)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Email Report Settings (Required for daily reports)
# Gmail example: use App Password, not regular password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-password  # Gmail App Password
RECIPIENT_EMAIL=hayeon2.kwon@samsung.com

# Email Schedule (KST)
# Morning report: 09:00 KST
# Afternoon report: 14:00 KST
EMAIL_REPORT_ENABLED=true
